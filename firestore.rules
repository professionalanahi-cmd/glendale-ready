rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only read and write their own account and profile.
    match /users/{uid} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
